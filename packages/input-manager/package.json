{
	"name": "@sofie-automation/input-manager",
	"version": "0.4.0",
	"description": "Have devices, send events, receive feedback",
	"main": "dist/index.js",
	"typings": "dist/index.d.ts",
	"module": "dist/module/index.js",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Sofie-Automation/sofie-input-gateway.git"
	},
	"bugs": {
		"url": "https://github.com/Sofie-Automation/sofie-input-gateway/issues"
	},
	"homepage": "https://github.com/Sofie-Automation/sofie-input-gateway#readme",
	"contributors": [
		{
			"name": "Johan Nyman",
			"email": "johan@superfly.tv",
			"url": "http://superfly.tv"
		},
		{
			"name": "Mint de Wit",
			"email": "mint@superfly.tv",
			"url": "http://superfly.tv"
		},
		{
			"name": "Jesper Stærkær",
			"email": "jesper@superfly.tv",
			"url": "http://superfly.tv"
		},
		{
			"name": "Jan Starzak",
			"email": "jan@superfly.tv",
			"url": "http://superfly.tv"
		},
		{
			"name": "Stephan Nordnes Eriksen",
			"email": "Stephanruler@gmail.com"
		},
		{
			"name": "Julian Waller",
			"email": "julian@superfly.tv",
			"url": "http://superfly.tv"
		}
	],
	"scripts": {
		"build": "run -T -B rimraf dist && run build:main",
		"build:main": "run -T -B tsc -p tsconfig.build.json",
		"build:watch": "run -T -B tsc -p tsconfig.build.json --watch",
		"lint:raw": "run -T g:eslint --ext .ts --ext .js --ext .tsx --ext .jsx --ignore-pattern dist",
		"lint": "run lint:raw .",
		"lint-fix": "run lint --fix",
		"license-validate": "run -T -B sofie-licensecheck",
		"unit": "vitest run",
		"unitci": "run unit --coverage",
		"test": "run lint && run unit",
		"validate:dependencies": "yarn npm audit --environment production && run license-validate",
		"validate:dev-dependencies": "yarn npm audit",
		"generate-schema-types": "node ./scripts/schema-types.mjs"
	},
	"engines": {
		"node": "^22.15"
	},
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw"
		]
	},
	"files": [
		"/dist",
		"/LICENSE"
	],
	"keywords": [
		"broadcast",
		"socket",
		"typescript",
		"javascript",
		"open",
		"source",
		"automation",
		"rundown",
		"production"
	],
	"dependencies": {
		"@elgato-stream-deck/node": "^7.6.3",
		"@elgato-stream-deck/tcp": "^7.6.3",
		"@julusian/jpeg-turbo": "^2.1.0",
		"easymidi": "^3.1.0",
		"eventemitter3": "5.0.1",
		"fold-to-ascii": "^5.0.1",
		"lru-cache": "11.0.2",
		"osc": "^2.4.4",
		"skia-canvas": "2.0.2",
		"xkeys": "^3.1.1"
	},
	"peerDependencies": {
		"@sofie-automation/shared-lib": "*"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@prettier/plugin-oxc": "^0.2.2",
		"@sofie-automation/code-standard-preset": "*",
		"@types/fold-to-ascii": "^5.0.2",
		"eslint": "*",
		"prettier": "*",
		"prettier-plugin-ember-template-tag": "^2.1.8"
	}
}
